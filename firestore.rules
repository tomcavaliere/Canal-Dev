rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ Remplace par ton UID Firebase (identique à ADMIN_UID dans js/firebase-config.js).
    function adminUid() {
      return "WcAMpEXuhYbQjgeUnIsyMxJsO5f1";
    }

    // Utilisateur connecté avec une adresse Gmail vérifiée.
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@gmail[.]com$');
    }

    function isAdmin() {
      return signedIn() && request.auth.uid == adminUid();
    }

    function isMember(convId) {
      return request.auth.uid in
        get(/databases/$(database)/documents/conversations/$(convId)).data.members;
    }

    function canAccess(convId) {
      return signedIn() && (isAdmin() || isMember(convId));
    }

    // ---------- Profils utilisateurs ----------
    match /users/{uid} {
      function validProfile() {
        let d = request.resource.data;
        return d.keys().hasOnly(['email', 'displayName', 'photoURL', 'createdAt', 'lastLogin'])
          && d.email == request.auth.token.email
          && d.displayName is string && d.displayName.size() <= 200
          && d.photoURL is string && d.photoURL.size() <= 2000
          && d.lastLogin == request.time;
      }

      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && validProfile()
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && validProfile()
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    // ---------- Conversations ----------
    match /conversations/{convId} {
      function validConversation() {
        let d = request.resource.data;
        return d.keys().hasOnly(['title', 'description', 'members', 'createdAt', 'updatedAt'])
          && d.title is string && d.title.size() > 0 && d.title.size() <= 120
          && d.description is string && d.description.size() <= 500
          && d.members is list;
      }

      // Lecture : l'admin, ou les membres de la conversation.
      allow read: if signedIn() && (isAdmin() || request.auth.uid in resource.data.members);
      // Création / modification (dont ajout/retrait de membres) / suppression : admin uniquement.
      allow create, update: if isAdmin() && validConversation();
      allow delete: if isAdmin();

      // ---------- Messages ----------
      match /messages/{msgId} {
        allow read: if canAccess(convId);
        allow create: if canAccess(convId)
          && request.resource.data.keys().hasOnly(['text', 'authorUid', 'authorName', 'authorPhoto', 'createdAt'])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() <= 200
          && request.resource.data.authorPhoto is string
          && request.resource.data.authorPhoto.size() <= 2000;
        allow update: if false;
        allow delete: if isAdmin()
          || (canAccess(convId) && resource.data.authorUid == request.auth.uid);
      }
    }

    // Tout le reste est interdit.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ Remplace par ton UID Firebase (identique à ADMIN_UID dans js/firebase-config.js).
    function adminUid() {
      return "WcAMpEXuhYbQjgeUnIsyMxJsO5f1";
    }

    // Utilisateur connecté avec une adresse Gmail vérifiée.
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@gmail[.]com$');
    }

    function isAdmin() {
      return signedIn() && request.auth.uid == adminUid();
    }

    function isMember(convId) {
      return request.auth.uid in
        get(/databases/$(database)/documents/conversations/$(convId)).data.members;
    }

    function canAccess(convId) {
      return signedIn() && (isAdmin() || isMember(convId));
    }

    // Limitation anti-abus : chaque écriture de message (envoi, modification, date d'activité)
    // doit mettre à jour, dans le même batch, le compteur rate/{uid} de son auteur (30 par minute).
    function rateBumped() {
      return getAfter(/databases/$(database)/documents/rate/$(request.auth.uid)).data.at == request.time;
    }

    // Invitation adressée à l'utilisateur connecté (identifiant = son email en minuscules).
    function myInvite() {
      return /databases/$(database)/documents/invites/$(request.auth.token.email.lower());
    }

    // Membre d'un projet : membre d'au moins une de ses conversations. Les règles ne pouvant pas
    // chercher parmi les conversations, chacun enregistre une fiche projects/{p}/members/{uid} qui
    // nomme une conversation du projet dont il est membre (`via`). Elle est revérifiée à chaque
    // accès : retiré de cette conversation (ou elle a changé de projet), on perd l'accès.
    function projectTicket(projectId) {
      return /databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid);
    }
    function inProjectConv(projectId, convId) {
      let c = get(/databases/$(database)/documents/conversations/$(convId)).data;
      return request.auth.uid in c.members && c.get('projectId', '') == projectId;
    }
    function isProjectMember(projectId) {
      return signedIn() && exists(projectTicket(projectId))
        && inProjectConv(projectId, get(projectTicket(projectId)).data.via);
    }
    function canSeeProject(projectId) {
      return isAdmin() || isProjectMember(projectId);
    }

    // ---------- Profils utilisateurs ----------
    match /users/{uid} {
      function validProfile() {
        let d = request.resource.data;
        // Minimisation RGPD : plus de photo de profil (les anciens profils la perdent à la connexion suivante).
        // `noReceipts` : réglage « Ne pas envoyer d'accusés de lecture ».
        // `noPresence` : réglage « Masquer ma présence en ligne ».
        return d.keys().hasOnly(['email', 'displayName', 'createdAt', 'lastLogin', 'noReceipts', 'noPresence'])
          && d.email == request.auth.token.email
          && d.displayName is string && d.displayName.size() <= 200
          && (!('noReceipts' in d) || d.noReceipts is bool)
          && (!('noPresence' in d) || d.noPresence is bool);
      }

      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && validProfile()
        && request.resource.data.lastLogin == request.time
        && request.resource.data.createdAt == request.time;
      // Connexion : au plus une mise à jour par minute.
      allow update: if signedIn() && request.auth.uid == uid
        && validProfile()
        && request.resource.data.lastLogin == request.time
        && request.resource.data.createdAt == resource.data.createdAt
        && request.time > resource.data.lastLogin + duration.value(60, 's');
      // Réglages (accusés de lecture, présence) : ces seuls champs, comptés par la limitation anti-abus.
      allow update: if signedIn() && request.auth.uid == uid
        && validProfile()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['noReceipts', 'noPresence'])
        && rateBumped();
      // Droit à l'effacement : l'utilisateur peut supprimer son propre profil.
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // ---------- Annuaire des noms affichés (tenu par l'administrateur) ----------
    // Seule source fiable du nom d'un auteur : `authorName` (messages) est saisi librement
    // par l'auteur et le nom du profil Google peut être changé par la personne elle-même.
    // Lire UNE entrée par son UID (identifiant aléatoire, connu seulement des membres d'une
    // conversation commune) : tout utilisateur connecté. Lister : admin uniquement.
    match /names/{uid} {
      function validName() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'updatedAt'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 200
          && d.updatedAt == request.time;
      }

      allow get: if signedIn();
      allow list: if isAdmin();
      allow create, update: if isAdmin() && validName();
      // Personne invitée : crée sa propre entrée, avec le nom choisi par l'admin dans l'invitation.
      allow create: if signedIn() && request.auth.uid == uid && validName()
        && exists(myInvite())
        && request.resource.data.name == get(myInvite()).data.name;
      // Droit à l'effacement : l'utilisateur peut supprimer sa propre entrée.
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // ---------- Invitations (une par email, créées par l'admin) ----------
    // La personne invitée la lit à sa connexion, s'ajoute aux conversations listées et retire
    // chacune de l'invitation dans le même batch : une invitation ne sert qu'une fois.
    match /invites/{email} {
      function validInvite() {
        let d = request.resource.data;
        return d.keys().hasOnly(['email', 'name', 'convIds', 'createdAt', 'updatedAt'])
          && d.email == email
          && email.matches('[a-z0-9._+-]+@gmail[.]com')
          && d.name is string && d.name.size() > 0 && d.name.size() <= 200
          && d.convIds is list && d.convIds.size() > 0 && d.convIds.size() <= 50
          && d.updatedAt == request.time;
      }
      function isInvitee() {
        return signedIn() && request.auth.token.email.lower() == email;
      }

      allow get: if isAdmin() || isInvitee();
      allow list: if isAdmin();
      allow create: if isAdmin() && validInvite() && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && validInvite() && request.resource.data.createdAt == resource.data.createdAt;
      // La personne invitée ne peut que retirer des conversations (acceptées, ou disparues).
      allow update: if isInvitee()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['convIds'])
        && resource.data.convIds.hasAll(request.resource.data.convIds)
        && request.resource.data.convIds.size() < resource.data.convIds.size();
      allow delete: if isAdmin() || isInvitee();
    }

    // ---------- Compteur anti-abus (un par utilisateur) ----------
    // Fenêtre d'une minute : `count` messages depuis `windowStart` (30 au plus) ; `at` = dernière écriture.
    // Une fois la minute écoulée, la fenêtre repart de zéro. Seul l'admin le supprime (sinon le
    // supprimer remettrait le compteur à zéro) : il le fait pour les comptes supprimés.
    match /rate/{uid} {
      function validRate() {
        let d = request.resource.data;
        return d.keys().hasOnly(['windowStart', 'count', 'at'])
          && d.at == request.time && d.count is int;
      }
      function freshWindow() {
        return request.resource.data.windowStart == request.time && request.resource.data.count == 1;
      }

      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid && validRate() && freshWindow();
      allow update: if signedIn() && request.auth.uid == uid && validRate() && (
        (request.time > resource.data.windowStart + duration.value(60, 's') && freshWindow())
        || (request.resource.data.windowStart == resource.data.windowStart
          && request.resource.data.count == resource.data.count + 1
          && request.resource.data.count <= 30));
      allow delete: if isAdmin();
    }

    // ---------- Projets (regroupent des conversations) ----------
    match /projects/{projectId} {
      // Rôles (facultatifs, écrits par l'admin seul, filtrés à l'affichage) :
      //   `roles`       : liste [{ id, name }] (20 au plus), dans l'ordre d'affichage ;
      //   `roleMembers` : map uid -> [id de rôle] (qui tient quel rôle) ;
      //   `roleUids`    : les mêmes UID à plat, pour retrouver ses rôles (export, effacement RGPD).
      // Logo (facultatif) : petite image PNG/WebP/JPEG en data URL (environ 45 Ko au plus).
      function validProject() {
        let d = request.resource.data;
        return d.keys().hasOnly(['title', 'description', 'createdAt', 'updatedAt', 'roles', 'roleMembers', 'roleUids', 'logo'])
          && d.title is string && d.title.size() > 0 && d.title.size() <= 120
          && d.description is string && d.description.size() <= 500
          && (!('logo' in d) || (d.logo is string && d.logo.size() <= 60000
            && d.logo.matches('data:image/(png|webp|jpeg);base64,[A-Za-z0-9+/=]+')))
          && (!('roles' in d) || (d.roles is list && d.roles.size() <= 20))
          && ('roleMembers' in d) == ('roleUids' in d)
          && (!('roleMembers' in d) || (d.roleMembers is map && d.roleMembers.size() <= 200
            && d.roleUids is list && d.roleUids.toSet() == d.roleMembers.keys().toSet()));
      }

      // Lister les projets : admin, ou ceux où l'on tient un rôle (requête filtrée sur roleUids).
      // Lire UN projet par son identifiant (aléatoire, connu seulement via une conversation dont on
      // est membre ou un rôle) : tout utilisateur connecté, pour afficher le projet et ses rôles.
      // Seules données personnelles : les UID des personnes qui tiennent un rôle (noms dans l'annuaire).
      allow list: if isAdmin() || (signedIn() && request.auth.uid in resource.data.roleUids);
      allow get: if signedIn();
      allow create, update: if isAdmin() && validProject();
      // Droit à l'effacement : une personne peut uniquement se retirer de tous ses rôles.
      allow update: if signedIn()
        && request.auth.uid in resource.data.roleUids
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roleMembers', 'roleUids'])
        && request.resource.data.roleUids == resource.data.roleUids.removeAll([request.auth.uid])
        && request.resource.data.roleMembers.diff(resource.data.roleMembers).affectedKeys().hasOnly([request.auth.uid])
        && !(request.auth.uid in request.resource.data.roleMembers);
      allow delete: if isAdmin();

      // ---------- Membres du projet (fiches, voir isProjectMember) ----------
      // Écrites par la personne elle-même (à l'ouverture de l'application) ou par l'admin, qui
      // les tient à jour. Lues par les membres du projet : c'est la liste des personnes invitables.
      match /members/{uid} {
        function validTicket() {
          let d = request.resource.data;
          let c = get(/databases/$(database)/documents/conversations/$(d.via)).data;
          return d.keys().hasOnly(['uid', 'via', 'at'])
            && d.uid == uid && d.at == request.time
            && d.via is string && d.via.matches('[A-Za-z0-9]{1,128}')
            && uid in c.members && c.get('projectId', '') == projectId;
        }

        allow get: if signedIn() && request.auth.uid == uid;
        allow read: if canSeeProject(projectId);
        allow create, update: if isAdmin() && validTicket();
        allow create, update: if signedIn() && request.auth.uid == uid && validTicket() && rateBumped();
        allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
      }

      // ---------- Réunions du calendrier ----------
      // Visibles par tous les membres du projet. Créées par un membre (l'organisateur, `createdBy`),
      // qui seul (avec l'admin) les modifie ou les supprime. Chaque invité (`attendees`) répond
      // présent ou absent dans `responses` = { uid: 'yes' | 'no' }, et rien d'autre.
      match /events/{eventId} {
        function responsesOf(data) {
          return data.get('responses', {});
        }
        function responseDiff() {
          return responsesOf(request.resource.data).diff(responsesOf(resource.data));
        }
        function validEvent() {
          let d = request.resource.data;
          return d.keys().hasOnly(['title', 'description', 'place', 'start', 'end', 'createdBy', 'attendees', 'responses', 'createdAt', 'updatedAt'])
            && d.title is string && d.title.size() > 0 && d.title.size() <= 120
            && d.description is string && d.description.size() <= 2000
            && d.place is string && d.place.size() <= 200
            && d.start is timestamp && d.end is timestamp
            && d.end >= d.start && d.end <= d.start + duration.value(24, 'h')
            && d.attendees is list && d.attendees.size() <= 50
            && responsesOf(d) is map && responsesOf(d).size() <= 50
            && d.createdBy is string
            && d.updatedAt == request.time;
        }

        allow read: if canSeeProject(projectId);
        allow create: if canSeeProject(projectId) && validEvent()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && responsesOf(request.resource.data).size() == 0
          && rateBumped();
        // Organisateur ou admin : tout modifier, sauf les réponses, qu'il peut seulement effacer
        // (invité retiré, horaire changé).
        allow update: if canSeeProject(projectId)
          && (isAdmin() || resource.data.createdBy == request.auth.uid)
          && validEvent()
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && responseDiff().addedKeys().size() == 0
          && responseDiff().changedKeys().size() == 0
          && rateBumped();
        // Invité : donner, changer ou retirer sa propre réponse.
        allow update: if canSeeProject(projectId)
          && request.auth.uid in resource.data.attendees
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['responses'])
          && responseDiff().affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in responsesOf(request.resource.data))
            || responsesOf(request.resource.data)[request.auth.uid] in ['yes', 'no'])
          && rateBumped();
        // Droit à l'effacement : un invité se retire de la liste (avec sa réponse).
        allow update: if signedIn()
          && request.auth.uid in resource.data.attendees
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendees', 'responses'])
          && request.resource.data.attendees == resource.data.attendees.removeAll([request.auth.uid])
          && responseDiff().affectedKeys().hasOnly([request.auth.uid])
          && !(request.auth.uid in responsesOf(request.resource.data));
        allow delete: if isAdmin() || (signedIn() && resource.data.createdBy == request.auth.uid);
      }

      // ---------- Objectifs du projet ----------
      // Tout membre en ajoute et coche ceux qui sont atteints (`doneBy` = qui a coché, `doneAt` = quand).
      // Seuls l'auteur et l'admin modifient le reste ou suppriment. `due` : date « AAAA-MM-JJ ».
      match /goals/{goalId} {
        function validGoal() {
          let d = request.resource.data;
          return d.keys().hasOnly(['title', 'due', 'done', 'doneBy', 'doneAt', 'createdBy', 'createdAt', 'updatedAt'])
            && d.title is string && d.title.size() > 0 && d.title.size() <= 200
            && (!('due' in d) || (d.due is string && d.due.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')))
            && d.done is bool
            && (d.done || (!('doneBy' in d) && !('doneAt' in d)))
            && d.createdBy is string
            && d.updatedAt == request.time;
        }
        // Cocher : signé et daté par la personne qui coche. Décocher : efface. Sinon : inchangé.
        function validDoneChange() {
          let n = request.resource.data;
          let o = resource.data;
          return (n.done == o.done && n.get('doneBy', null) == o.get('doneBy', null)
              && n.get('doneAt', null) == o.get('doneAt', null))
            || (n.done && !o.done && n.get('doneBy', null) == request.auth.uid && n.get('doneAt', null) == request.time)
            || (!n.done && o.done);
        }

        allow read: if canSeeProject(projectId);
        allow create: if canSeeProject(projectId) && validGoal()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.done == false
          && rateBumped();
        // Auteur ou admin : tout modifier.
        allow update: if canSeeProject(projectId)
          && (isAdmin() || resource.data.createdBy == request.auth.uid)
          && validGoal() && validDoneChange()
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && rateBumped();
        // Tout membre : cocher ou décocher.
        allow update: if canSeeProject(projectId) && validGoal() && validDoneChange()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'doneBy', 'doneAt', 'updatedAt'])
          && rateBumped();
        // Droit à l'effacement : retirer son nom d'un objectif qu'on a coché.
        allow update: if signedIn()
          && resource.data.get('doneBy', '') == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['doneBy'])
          && !('doneBy' in request.resource.data);
        allow delete: if isAdmin() || (signedIn() && resource.data.createdBy == request.auth.uid);
      }
    }

    // ---------- Conversations ----------
    match /conversations/{convId} {
      function validConversation() {
        let d = request.resource.data;
        return d.keys().hasOnly(['title', 'description', 'members', 'projectId', 'createdAt', 'updatedAt', 'lastMessageAt', 'links', 'pinned'])
          && d.title is string && d.title.size() > 0 && d.title.size() <= 120
          && d.description is string && d.description.size() <= 500
          && d.members is list
          // Liens attachés ({ label, url }) : écrits par l'admin seul, filtrés à l'affichage (http/https uniquement).
          && (!('links' in d) || (d.links is list && d.links.size() <= 30))
          // Messages épinglés (identifiants seulement, jamais leur contenu) : écrits par l'admin seul.
          && (!('pinned' in d) || (d.pinned is list && d.pinned.size() <= 10))
          && (!('lastMessageAt' in d) || d.lastMessageAt is timestamp)
          && (!('projectId' in d) || (d.projectId is string && d.projectId.size() > 0 && d.projectId.size() <= 128));
      }

      // Lecture : l'admin, ou les membres de la conversation.
      allow read: if signedIn() && (isAdmin() || request.auth.uid in resource.data.members);
      // Création / modification (dont ajout/retrait de membres) / suppression : admin uniquement.
      allow create, update: if isAdmin() && validConversation();
      // Droit à l'effacement : un membre peut uniquement se retirer lui-même de la liste.
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members == resource.data.members.removeAll([request.auth.uid]);
      // Activité (tri de la liste) : un membre met à jour la date du dernier message,
      // dans le batch qui envoie le message. Aucun autre champ, et seulement à l'heure du serveur.
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageAt'])
        && request.resource.data.lastMessageAt == request.time
        && rateBumped();
      // Invitation : la personne invitée s'ajoute elle-même (et rien d'autre), à condition que la
      // conversation figure dans son invitation et qu'elle l'en retire dans le même batch.
      allow update: if signedIn()
        && exists(myInvite())
        && convId in get(myInvite()).data.convIds
        && !(request.auth.uid in resource.data.members)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members == resource.data.members.concat([request.auth.uid])
        && (!existsAfter(myInvite()) || !(convId in getAfter(myInvite()).data.convIds));
      allow delete: if isAdmin();

      // ---------- Messages ----------
      match /messages/{msgId} {
        // `image` (facultatif) ne contient que les dimensions ; la photo elle-même est
        // dans images/{msgId}, écrite dans le même batch, et sa miniature (si `thumb`) dans thumbs/{msgId}.
        function validImageMeta(img) {
          return img is map && img.keys().hasOnly(['w', 'h', 'thumb'])
            && img.w is int && img.w > 0 && img.w <= 1600
            && img.h is int && img.h > 0 && img.h <= 1600
            && existsAfter(/databases/$(database)/documents/conversations/$(convId)/images/$(msgId))
            && (!('thumb' in img) || (img.thumb == true
              && existsAfter(/databases/$(database)/documents/conversations/$(convId)/thumbs/$(msgId))));
        }
        // `replyTo` (facultatif) : identifiant d'un message existant de la même conversation.
        function validReplyTo(id) {
          return id is string && id.matches('[A-Za-z0-9]{1,128}')
            && exists(/databases/$(database)/documents/conversations/$(convId)/messages/$(id));
        }
        function validMessage() {
          let d = request.resource.data;
          return d.keys().hasOnly(['text', 'authorUid', 'authorName', 'createdAt', 'image', 'replyTo'])
            && d.authorUid == request.auth.uid
            && d.createdAt == request.time
            && d.text is string
            && d.text.size() <= 4000
            && (d.text.size() > 0 || 'image' in d)
            && (!('image' in d) || validImageMeta(d.image))
            && (!('replyTo' in d) || validReplyTo(d.replyTo))
            && d.authorName is string
            && d.authorName.size() <= 200;
        }

        // Modification par son auteur : le texte seul, daté par le serveur (mention « modifié »).
        function validEdit() {
          let d = request.resource.data;
          return d.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
            && d.editedAt == request.time
            && d.text is string
            && d.text.size() <= 4000
            && (d.text.size() > 0 || 'image' in d);
        }

        // Annonces « X a rejoint / a quitté la conversation » : `authorUid` est la personne
        // concernée (export et suppression de ses données la couvrent ainsi). Écrites par l'admin
        // ou par elle-même, uniquement dans le batch qui l'ajoute aux membres ou l'en retire.
        function validMemberEvent() {
          let d = request.resource.data;
          let conv = /databases/$(database)/documents/conversations/$(convId);
          let before = d.authorUid in get(conv).data.members;
          let after = d.authorUid in getAfter(conv).data.members;
          return d.keys().hasOnly(['event', 'authorUid', 'createdAt'])
            && d.createdAt == request.time
            && d.authorUid is string
            && (isAdmin() || d.authorUid == request.auth.uid)
            && ((d.event == 'join' && !before && after) || (d.event == 'leave' && before && !after));
        }

        // Réactions : `reactions` = { uid: emoji }, une par membre, parmi une liste fixe
        // (identique à REACTIONS dans js/emoji.js). Aucun autre champ ne change.
        function reactionsOf(data) {
          return data.get('reactions', {});
        }
        function reactionDiff() {
          return reactionsOf(request.resource.data).diff(reactionsOf(resource.data));
        }
        function onlyReactions() {
          return !('event' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
            && reactionsOf(request.resource.data) is map;
        }
        // Mettre ou changer sa propre réaction (comptée par la limitation anti-abus).
        function validReaction() {
          let after = reactionsOf(request.resource.data);
          return onlyReactions()
            && reactionDiff().affectedKeys().hasOnly([request.auth.uid])
            && request.auth.uid in after
            && after[request.auth.uid] in ['👍', '❤️', '😂', '😮', '😢', '🙏'];
        }
        // Retirer des réactions sans rien ajouter : la sienne (membre), ou celles de n'importe
        // qui (admin, à la suppression d'un compte).
        function validUnreact() {
          return onlyReactions()
            && reactionDiff().addedKeys().size() == 0
            && reactionDiff().changedKeys().size() == 0
            && (isAdmin() || reactionDiff().removedKeys().hasOnly([request.auth.uid]));
        }

        allow read: if canAccess(convId);
        allow create: if canAccess(convId) && validMessage() && rateBumped();
        allow create: if signedIn() && validMemberEvent();
        allow update: if canAccess(convId) && resource.data.authorUid == request.auth.uid
          && !('event' in resource.data) && validEdit() && rateBumped();
        allow update: if canAccess(convId) && validReaction() && rateBumped();
        allow update: if canAccess(convId) && validUnreact();
        allow delete: if isAdmin()
          || (canAccess(convId) && resource.data.authorUid == request.auth.uid);
      }

      // ---------- Photos (une par message, même identifiant que le message) ----------
      match /images/{imgId} {
        function validImage() {
          let d = request.resource.data;
          let parts = d.data.split(',');
          return d.keys().hasOnly(['data', 'authorUid', 'createdAt'])
            && d.authorUid == request.auth.uid
            && d.createdAt == request.time
            && d.data is string
            && d.data.size() <= 900000
            && parts.size() == 2
            && parts[0] == 'data:image/jpeg;base64'
            && getAfter(/databases/$(database)/documents/conversations/$(convId)/messages/$(imgId)).data.authorUid == request.auth.uid;
        }

        allow read: if canAccess(convId);
        allow create: if canAccess(convId) && validImage();
        allow update: if false;
        allow delete: if isAdmin()
          || (canAccess(convId) && resource.data.authorUid == request.auth.uid);
      }

      // ---------- Miniatures des photos (même identifiant que le message) ----------
      // Affichées dans le fil ; l'original (images/) n'est chargé qu'à l'agrandissement.
      match /thumbs/{thumbId} {
        function validThumb() {
          let d = request.resource.data;
          let parts = d.data.split(',');
          return d.keys().hasOnly(['data', 'authorUid', 'createdAt'])
            && d.authorUid == request.auth.uid
            && d.createdAt == request.time
            && d.data is string
            && d.data.size() <= 60000
            && parts.size() == 2
            && parts[0] == 'data:image/jpeg;base64'
            && getAfter(/databases/$(database)/documents/conversations/$(convId)/messages/$(thumbId)).data.authorUid == request.auth.uid;
        }

        allow read: if canAccess(convId);
        allow create: if canAccess(convId) && validThumb();
        allow update: if false;
        allow delete: if isAdmin()
          || (canAccess(convId) && resource.data.authorUid == request.auth.uid);
      }

      // ---------- Accusés de lecture (un par membre, identifiant = UID) ----------
      // Date à laquelle le membre a vu pour la dernière fois la conversation, visible
      // par les autres membres (« Vu par … » sous le dernier message envoyé).
      // Pas de nom : il est lu dans l'annuaire (names/{uid}). Les anciens accusés qui en
      // contiennent un le perdent à leur prochaine écriture.
      match /reads/{uid} {
        function validRead() {
          let d = request.resource.data;
          return d.keys().hasOnly(['uid', 'lastRead'])
            && d.uid == uid
            && d.lastRead == request.time;
        }

        allow read: if canAccess(convId);
        allow create, update: if canAccess(convId) && request.auth.uid == uid && validRead();
        allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
      }
    }

    // ---------- Droits RGPD : accès / portabilité / effacement ----------
    // Requête collection group sur tous les messages d'un auteur (export et suppression
    // de compte), y compris dans des conversations dont il n'est plus membre.
    match /{path=**}/messages/{msgId} {
      allow read, delete: if isAdmin()
        || (signedIn() && resource.data.authorUid == request.auth.uid);
    }
    match /{path=**}/images/{imgId} {
      allow read, delete: if isAdmin()
        || (signedIn() && resource.data.authorUid == request.auth.uid);
    }
    match /{path=**}/thumbs/{thumbId} {
      allow read, delete: if isAdmin()
        || (signedIn() && resource.data.authorUid == request.auth.uid);
    }
    match /{path=**}/reads/{readId} {
      allow read, delete: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
    }
    // Calendrier : ses fiches de membre, les réunions qu'on organise ou où l'on est invité
    // (aussi pour la pastille des invitations), les objectifs qu'on a créés ou cochés.
    match /{path=**}/members/{uid} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }
    match /{path=**}/events/{eventId} {
      allow read: if isAdmin() || (signedIn() && (resource.data.createdBy == request.auth.uid
        || request.auth.uid in resource.data.attendees));
    }
    match /{path=**}/goals/{goalId} {
      allow read: if isAdmin() || (signedIn() && (resource.data.createdBy == request.auth.uid
        || resource.data.get('doneBy', '') == request.auth.uid));
    }

    // Tout le reste est interdit.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
